{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kereta",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "public", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "kereta", "database_id": "local-placeholder", "migrations_dir": "migrations" }
  ],
  "vars": { "SCAN_MODEL": "google/gemini-2.5-flash" }
}
