{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lejar",
	"main": "src/index.tsx",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "public",
		"binding": "ASSETS"
	},
	"vars": {
		"SCAN_MODEL": "google/gemini-2.5-flash",
		"SCAN_CAP_PER_USER": "20",
		"SCAN_CAP_GLOBAL": "300"
	},
	"r2_buckets": [
		{
			"binding": "RECEIPTS",
			"bucket_name": "lejar-receipts"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lejar",
			"database_id": "90226b4e-e33a-486b-877d-415b7436cf2c",
			"migrations_dir": "migrations"
		}
	]
}