{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kereta",
	"main": "src/index.tsx",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "public",
		"binding": "ASSETS"
	},
	"vars": {
		"SCAN_MODEL": "google/gemini-2.5-flash",
		"SCAN_CAP_PER_USER": "20",
		"SCAN_CAP_GLOBAL": "300"
	},
	"r2_buckets": [
		{
			"binding": "RECEIPTS",
			"bucket_name": "kereta-receipts"
		},
		{
			"bucket_name": "kereta-receipts",
			"binding": "kereta_receipts",
			"remote": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kereta",
			"database_id": "a69ab5a1-8eef-4254-84b5-648c2d283713",
			"migrations_dir": "migrations"
		},
		{
			"binding": "kereta",
			"database_name": "kereta",
			"database_id": "a69ab5a1-8eef-4254-84b5-648c2d283713",
			"remote": true
		}
	]
}